{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@tutoros/types/*": ["packages/types/src/*"],
      "@tutoros/ai/*": ["packages/ai/src/*"],
      "@tutoros/db/*": ["packages/db/src/*"],
      "@tutoros/ui/*": ["packages/ui/src/*"],
      "@tutoros/config/*": ["packages/config/src/*"]
    }
  }
}
