generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector(map: "vector")]
}

enum MaterialType {
  SYLLABUS
  BOOK
  NOTES
  SLIDES
  ASSIGNMENT
  OTHER
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CourseLevel {
  SCHOOL
  UNDERGRADUATE
  GRADUATE
  PROFESSIONAL
}

enum LearningGoal {
  PASS_EXAM
  DEEP_UNDERSTANDING
  HOMEWORK_HELP
  REVISION
}

enum LessonRole {
  SYSTEM
  TUTOR
  STUDENT
  TOOL
}

enum AnimationStatus {
  QUEUED
  RENDERING
  COMPLETED
  FAILED
}

model User {
  id                    String               @id @default(cuid())
  clerkId               String               @unique
  email                 String               @unique
  name                  String?
  preferredStyle        String?              @default("standard_university")
  confidenceLevel       Float                @default(0.5)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  courses               Course[]
  lessons               Lesson[]
  masteryRecords        MasteryRecord[]
  misconceptions        MisconceptionLog[]
  studyRecommendations  StudyRecommendation[]
}

model Course {
  id                   String                @id @default(cuid())
  userId               String
  title                String
  description          String?
  level                CourseLevel
  learningGoal         LearningGoal
  ingestionStatus      IngestionStatus       @default(PENDING)
  progressPct          Float                 @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id])
  materials            CourseMaterial[]
  modules              CourseModule[]
  topics               Topic[]
  lessons              Lesson[]
  quizzes              Quiz[]
  flashcards           Flashcard[]
  recommendations      StudyRecommendation[]
}

model CourseMaterial {
  id                  String                 @id @default(cuid())
  courseId            String
  title               String
  materialType        MaterialType
  storageKey          String
  mimeType            String
  ingestionStatus     IngestionStatus        @default(PENDING)
  createdAt           DateTime               @default(now())
  course              Course                 @relation(fields: [courseId], references: [id])
  chunks              Chunk[]
}

model CourseModule {
  id                  String                 @id @default(cuid())
  courseId            String
  title               String
  weekNumber          Int?
  orderIndex          Int
  course              Course                 @relation(fields: [courseId], references: [id])
  topics              Topic[]
}

model Topic {
  id                  String                 @id @default(cuid())
  courseId            String
  moduleId            String?
  title               String
  description         String?
  learningObjectives  Json
  orderIndex          Int
  course              Course                 @relation(fields: [courseId], references: [id])
  module              CourseModule?          @relation(fields: [moduleId], references: [id])
  prerequisites       TopicDependency[]      @relation("TopicPrerequisite")
  dependents          TopicDependency[]      @relation("TopicDependent")
  chunks              Chunk[]
  masteryRecords      MasteryRecord[]
  misconceptionLogs   MisconceptionLog[]
  studyRecommendations StudyRecommendation[]
}

model TopicDependency {
  id                  String                 @id @default(cuid())
  topicId             String
  prerequisiteId      String
  strength            Float                  @default(0.5)
  topic               Topic                  @relation("TopicDependent", fields: [topicId], references: [id])
  prerequisite        Topic                  @relation("TopicPrerequisite", fields: [prerequisiteId], references: [id])

  @@unique([topicId, prerequisiteId])
}

model Chunk {
  id                  String                 @id @default(cuid())
  materialId          String
  topicId             String?
  content             String
  ordinal             Int
  tokenCount          Int
  metadata            Json
  material            CourseMaterial         @relation(fields: [materialId], references: [id])
  topic               Topic?                 @relation(fields: [topicId], references: [id])
  embeddingReference  EmbeddingReference?
  lessonMessages      LessonMessage[]
}

model EmbeddingReference {
  id                  String                 @id @default(cuid())
  chunkId             String                 @unique
  vector              Unsupported("vector")
  model               String
  dimensions          Int
  createdAt           DateTime               @default(now())
  chunk               Chunk                  @relation(fields: [chunkId], references: [id])
}

model Lesson {
  id                  String                 @id @default(cuid())
  courseId            String
  userId              String
  topicId             String?
  teachingMode        String
  explanationStyle    String
  summary             String?
  startedAt           DateTime               @default(now())
  endedAt             DateTime?
  course              Course                 @relation(fields: [courseId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  messages            LessonMessage[]
  whiteboardEvents    WhiteboardEvent[]
  animationJobs       AnimationJob[]
  quizAttempts        QuizAttempt[]
}

model LessonMessage {
  id                  String                 @id @default(cuid())
  lessonId            String
  role                LessonRole
  content             String
  citations           Json?
  chunkId             String?
  createdAt           DateTime               @default(now())
  lesson              Lesson                 @relation(fields: [lessonId], references: [id])
  chunk               Chunk?                 @relation(fields: [chunkId], references: [id])
}

model WhiteboardEvent {
  id                  String                 @id @default(cuid())
  lessonId            String
  commandType         String
  payload             Json
  orderIndex          Int
  createdAt           DateTime               @default(now())
  lesson              Lesson                 @relation(fields: [lessonId], references: [id])
}

model AnimationJob {
  id                  String                 @id @default(cuid())
  lessonId            String
  prompt              String
  conceptType         String
  status              AnimationStatus        @default(QUEUED)
  outputUrl           String?
  error               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  lesson              Lesson                 @relation(fields: [lessonId], references: [id])
}

model Quiz {
  id                  String                 @id @default(cuid())
  courseId            String
  topicId             String?
  title               String
  generatedByLessonId String?
  createdAt           DateTime               @default(now())
  course              Course                 @relation(fields: [courseId], references: [id])
  questions           QuizQuestion[]
  attempts            QuizAttempt[]
}

model QuizQuestion {
  id                  String                 @id @default(cuid())
  quizId              String
  prompt              String
  questionType        String
  options             Json?
  answerKey           Json
  explanation         String
  orderIndex          Int
  quiz                Quiz                   @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id                  String                 @id @default(cuid())
  quizId              String
  userId              String
  lessonId            String?
  score               Float
  responses           Json
  misconceptions      Json
  createdAt           DateTime               @default(now())
  quiz                Quiz                   @relation(fields: [quizId], references: [id])
  lesson              Lesson?                @relation(fields: [lessonId], references: [id])
}

model Flashcard {
  id                  String                 @id @default(cuid())
  courseId            String
  topicId             String?
  front               String
  back                String
  difficulty          Int                    @default(2)
  nextReviewAt        DateTime
  createdAt           DateTime               @default(now())
  course              Course                 @relation(fields: [courseId], references: [id])
}

model MasteryRecord {
  id                  String                 @id @default(cuid())
  userId              String
  topicId             String
  confidence          Float                  @default(0.5)
  evidence            String
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id])
  topic               Topic                  @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
}

model MisconceptionLog {
  id                  String                 @id @default(cuid())
  userId              String
  topicId             String
  category            String
  note                String
  createdAt           DateTime               @default(now())
  user                User                   @relation(fields: [userId], references: [id])
  topic               Topic                  @relation(fields: [topicId], references: [id])
}

model StudyRecommendation {
  id                  String                 @id @default(cuid())
  userId              String
  courseId            String
  topicId             String
  reason              String
  dueAt               DateTime
  createdAt           DateTime               @default(now())
  user                User                   @relation(fields: [userId], references: [id])
  course              Course                 @relation(fields: [courseId], references: [id])
  topic               Topic                  @relation(fields: [topicId], references: [id])
}
