{
  "name": "@tutoros/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "echo 'no lint for db'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@tutoros/ai": "workspace:*",
    "@tutoros/types": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1"
  }
}
